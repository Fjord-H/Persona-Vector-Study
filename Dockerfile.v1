# Use Python 3.10 slim base image
FROM python:3.10-slim

# Set working directory inside container
WORKDIR /app

# Copy requirements file
COPY dashboard_requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r dashboard_requirements.txt

# Copy application files
COPY dashboard_v1.py .
COPY data/ data/
COPY figures/ figures/

# Expose port 8502 (for dashboard_v1)
EXPOSE 8502

# Health check 
HEALTHCHECK --interval=30s --timeout=3s \
  CMD curl -f http://localhost:8502/_stcore/health || exit 1

# Run the dashboard
CMD ["streamlit", "run", "dashboard_v1.py", "--server.port=8502", "--server.address=0.0.0.0"]