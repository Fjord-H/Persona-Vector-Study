# Use Python 3.10 slim base image
FROM python:3.10-slim

# Set working directory inside container
WORKDIR /app

# Copy requirements file
COPY dashboard_requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r dashboard_requirements.txt

# Copy application files
COPY dashboard_v0.py .
COPY data/ data/
COPY figures/ figures/

# Expose port 8501 (for dashboard v0)
EXPOSE 8501

# Run the dashboard v0
CMD ["streamlit", "run", "dashboard_v0.py", "--server.port=8501", "--server.address=0.0.0.0"]